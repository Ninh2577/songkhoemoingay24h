{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{chi-tiet-bai-viet.html,404.html}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/kien-thuc-can-biet", "destination": "/blog.html" },
    { "source": "/tri", "destination": "/blog.html" },
    { "source": "/dinh-chi-thai", "destination": "/blog.html" },
    { "source": "/bao-quy-dau", "destination": "/blog.html" },
    { "source": "/gioi-thieu", "destination": "/gioi-thieu.html" },
    { "source": "/dieu-khoan-su-dung", "destination": "/dieu-khoan-su-dung.html" },
    { "source": "/chinh-sach-bao-mat", "destination": "/chinh-sach-bao-mat.html" },
    { "source": "/mien-tru-trach-nhiem", "destination": "/mien-tru-trach-nhiem.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/image/:id([a-zA-Z0-9\\-_]+)/:filename(.*)", "destination": "https://ap-south-1.graphassets.com/cmrezpqjy0epy06pp7qgqcua7/:id" },
    { "source": "/asset-proxy/:host/:env/:id/:filename(.*\\..+)", "destination": "https://:host/:env/:id" },
    { "source": "/asset-proxy/:host/:id/:filename(.*\\..+)", "destination": "https://:host/:id" },
    { "source": "/asset-proxy/:host/:path*", "destination": "https://:host/:path*" },
    { "source": "/:slug([^.]+)", "destination": "/api/render-article" }
  ]
}
